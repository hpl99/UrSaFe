{
  "name": "ursafe-monorepo",
  "version": "1.0.0",
  "description": "UrSafe / Cascade26 - Real Offline-First Emergency Communication & Coordination Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "node apps/api/server.js",
    "dev:frontend": "node apps/web-console/server.js",
    "dev:all": "node apps/web-console/server.js",
    "dev:web": "node apps/web-console/server.js",
    "test": "npm run test:web && npm run test:python",
    "test:python": "pytest tests/ -v",
    "test:web": "echo \"Running web-console tests...\"",
    "lint": "echo \"Running monorepo lint checks...\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
